{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "model": "openai/gpt-6-astra",
  "agent": {
    "build": {
      "model": "openai/gpt-6-astra",
      "reasoningEffort": "medium"
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": "allow",
    "doom_loop": "allow",
    "question": "deny",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git checkout -- *": "deny",
      "git clean *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "scancel *": "deny"
    }
  }
}
